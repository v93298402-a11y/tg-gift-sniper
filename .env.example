# Telegram API credentials.
# Можно оставить пустыми — будут использованы публичные ключи Telegram Desktop.
# Или вписать свои с https://my.telegram.org
# API_ID=12345678
# API_HASH=your_api_hash_here

# Session name (file will be <SESSION_NAME>.session)
SESSION_NAME=sniper

# Bot interface token (from @BotFather). Required for --bot mode.
# BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Third-party marketplace tokens (optional).
# MRKT: Open tgmrkt.io → DevTools → Network → Authorization header
# MRKT_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Portals: Open @portals mini app → DevTools → Network → Authorization header
# PORTALS_TOKEN=tma ...

# Whale-feed mode (--whale): post Telegram Resale sales >= 100 TON to a channel.
# Bot must be admin of the channel with permission to post messages.
# WHALE_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# WHALE_CHANNEL=@your_channel_username
#
# Optional — enable Getgems as an additional whale-feed source.
# Get an API key by connecting a TON wallet at https://getgems.io/public-api
# (rate limit: 400 req / 5 min, free).
# GETGEMS_API_KEY=1777275841850-mainnet-..............................
