# Telegram API credentials.
# Можно оставить пустыми — будут использованы публичные ключи Telegram Desktop.
# Или вписать свои с https://my.telegram.org
# API_ID=12345678
# API_HASH=your_api_hash_here

# Session name (file will be <SESSION_NAME>.session)
SESSION_NAME=sniper

# Bot interface token (from @BotFather). Required for --bot mode.
# BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
